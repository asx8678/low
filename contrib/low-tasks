#!/usr/bin/env bash
# low-tasks FILE [LOW OPTIONS]: runs the tasks in FILE, one per line (blank lines and lines starting with # are
# skipped), in one low session. The first task starts the session and each later task resumes it, so every task sees
# what the earlier ones did and the provider's prompt cache carries over. Stops at the first task low does not verify
# (a non-zero exit), or when a resume picks up some other session of this repo. Options such as -m MODEL or --yolo go
# to every low call; a resumed session already uses its model, so repeating -m changes nothing.
if [ $# -lt 1 ]; then
    echo "usage: low-tasks FILE [-m MODEL] [--yolo]" >&2
    exit 2
fi
file=$1
shift
err=$(mktemp) || exit 1
trap 'rm -f "$err"' EXIT
session=
n=0
while IFS= read -r task <&3 || [ -n "$task" ]; do
    case $task in '' | '#'*) continue ;; esac
    n=$((n + 1))
    printf '\n── task %d: %s\n' "$n" "$task" >&2
    # low prints [session PATH] or [resumed PATH] on stderr before the turn starts; tee keeps it on screen too. The --
    # keeps a task that starts with a dash, such as a "- fix the tests" bullet, from being read as an option.
    if [ -z "$session" ]; then
        low "$@" -- "$task" </dev/null 2> >(tee "$err" >&2)
        status=$?
        session=$(sed -n 's/^\[session \(.*\)\]$/\1/p' "$err" | head -n 1)
    else
        low "$@" --resume -- "$task" </dev/null 2> >(tee "$err" >&2)
        status=$?
        resumed=$(sed -n 's/^\[resumed \(.*\)\]$/\1/p' "$err" | head -n 1)
        if [ "$resumed" != "$session" ]; then
            echo "low-tasks: task $n resumed ${resumed:-no session}, not $session; stopping" >&2
            exit 1
        fi
    fi
    if [ "$status" -ne 0 ]; then
        echo "low-tasks: task $n was not verified (low exited $status); stopping. Session: ${session:-none}" >&2
        exit 1
    fi
    if [ -z "$session" ]; then
        echo "low-tasks: low printed no [session ...] line; stopping" >&2
        exit 1
    fi
done 3<"$file"
echo "low-tasks: $n tasks verified in ${session:-no session}" >&2
